{
  "cleanUrls": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "prociel.com.br" }], "destination": "https://www.prociel.com.br/$1", "permanent": true }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(media|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/(llms.txt|robots.txt|sitemap.xml)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
